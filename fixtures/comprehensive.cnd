              "children": [
                {
                  "id": "00000000-0000-4000-b000-000000000014",
                  "type": "paragraph",
                  "text": "Les alarmes sont classées en quatre niveaux de criticité : info, avertissement, alarme, critique.",
                  "lang": "fr",
                  "location": {
                    "page": 4
                  }
                },
                {
                  "id": "00000000-0000-4000-b000-000000000015",
                  "type": "paragraph",
                  "text": "Le délai d'acquittement maximal est défini par la politique site. Consulter la matrice des délais.",
                  "lang": "fr",
                  "location": {
                    "page": 5
                  },
                  "refs": [
                    {
                      "label": "tab-delais-alarmes"
                    }
                  ]

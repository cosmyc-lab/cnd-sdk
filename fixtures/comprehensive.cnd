  "nodes": [
    {
      "id": "00000000-0000-4000-b000-000000000001",
      "type": "paragraph",
      "text": "Résumé exécutif placé avant le premier titre. Ce paragraphe doit produire un chunk isolé avec un heading_path vide.",
      "lang": "fr",
      "location": {
        "page": 1
      }
    },
    {
      "id": "00000000-0000-4000-b000-000000000002",
      "type": "heading",
      "level": 1,
      "text": "Architecture générale",
      "heading_path": [
        "1 Architecture générale"
      ],
      "label": "ch-architecture",
      "location": {
        "page": 1
      },
      "children": [
        {
          "id": "00000000-0000-4000-b000-000000000003",
          "type": "paragraph",
          "text": "Le système DCS repose sur trois couches fonctionnelles : acquisition, traitement et supervision.",
          "lang": "fr",
          "state_metadata": {
            "revision": "4.2",
            "status": "approved"
          },
          "location": {
            "page": 1
          }
        },
        {
          "id": "00000000-0000-4000-b000-000000000004",
          "type": "heading",
          "level": 2,
          "text": "Couche d'acquisition",
          "heading_path": [
            "1 Architecture générale",
            "1.1 Couche d'acquisition"
          ],
          "label": "sec-acquisition",
          "location": {
            "page": 2
          },
          "children": [
            {
              "id": "00000000-0000-4000-b000-000000000005",
              "type": "paragraph",
              "text": "Les capteurs analogiques et numériques sont regroupés par bus de terrain. Voir le tableau des plages de mesure.",
              "lang": "fr",
              "location": {
                "page": 2
              },
              "refs": [
                {
                  "label": "tab-plages-mesure"
                }
              ]
            },
            {
              "id": "00000000-0000-4000-b000-000000000006",
              "type": "paragraph",
              "text": "La fréquence d'échantillonnage nominale est de 10 Hz pour les boucles rapides.",
              "lang": "fr",
              "location": {
                "page": 2
              }
            },
            {
              "id": "00000000-0000-4000-c000-000000000001",

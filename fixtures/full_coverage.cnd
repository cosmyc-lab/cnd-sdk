              },
              "location": {
                "page": 2
              }
            }
          ]
        },
        {
          "id": "00000000-0000-4000-e000-000000000007",
          "type": "code",
          "location": {
            "page": 2
          },
          "text": "def moyenne(valeurs):\n    return sum(valeurs) / len(valeurs)",
          "lang": "python"
        },

            {
              "term": {
                "value": "Banc"
              },
              "children": [
                {
                  "id": "00000000-0000-4000-c000-000000000008",
                  "type": "paragraph",
                  "text": {
                    "value": "Ensemble mécanique portant les capteurs sous test."
                  },
                  "location": {
                    "page": 2
                  }
                }
              ]
            },
            {
              "term": {
                "value": "Cycle"
              },
              "children": [
                {
                  "id": "00000000-0000-4000-c000-000000000009",
                  "type": "paragraph",
                  "text": {
                    "value": "Séquence complète de montée et descente en charge."
                  },
                  "location": {
                    "page": 2
                  }
                }
              ]
            },
            {
              "term": {
                "value": "Dérive"
              },
              "children": [
                {
                  "id": "00000000-0000-4000-c000-000000000010",
                  "type": "paragraph",
                  "text": {
                    "value": "Écart de mesure observé entre deux étalonnages."
                  },
                  "location": {
                    "page": 2
                  }
                }
              ]
            }
          ]
        },
        {
          "id": "00000000-0000-4000-e000-000000000006",
          "type": "quote",
          "location": {
            "page": 2
          },
          "attribution": {

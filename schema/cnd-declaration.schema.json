                "math": "#/$defs/DeclMathNode",
                "paragraph": "#/$defs/DeclParagraphNode",
                "quote": "#/$defs/DeclQuoteNode",
                "table": "#/$defs/DeclTableNode",
                "terms": "#/$defs/DeclTermsNode"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/DeclHeadingNode"

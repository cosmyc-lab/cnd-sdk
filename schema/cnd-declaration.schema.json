          },
          "title": "Cites",
          "type": "array"
        },
        "footnotes": {
          "items": {
            "$ref": "#/$defs/FootnoteRef"
          },
          "title": "Footnotes",
          "type": "array"
        },
        "state_metadata": {
          "additionalProperties": true,
          "title": "State Metadata",
          "type": "object"
        },
        "type": {
          "const": "heading",
          "title": "Type",
          "type": "string"
        },
        "level": {
          "minimum": 1,
          "title": "Level",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "counter_label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Counter Label"

    "DeclListItem": {
      "additionalProperties": false,
      "description": "One item of a declaration list.\n\n``number`` is an **override**, not a resolved ordinal: absent means\n\"number this item sequentially\", present means an explicit start or\nskip (markdown's ``3.`` on the first item of an ordered list). This is\nthe one place the declaration keeps a ``number`` the CND resolves \u2014 it\nkeeps the *authored* half (the override) and drops the *derived* half\n(the running ordinal), the same line drawn for figure numbers.\n\nResolution rule the builder follows (pinned so two builders cannot\ndiverge): an item with no ``number`` takes the previous sibling's\nresolved number plus one, starting from 1; an item *with* a ``number``\ntakes it verbatim, and following items count on from there. So a\n``number`` **rebases** the rest of the list rather than only labelling\nits own item. Ignored on an ``ordered: false`` list, which has no\nordinals.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "number": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Number"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/DeclListItem"
          },
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "DeclListItem",
      "type": "object"
    },

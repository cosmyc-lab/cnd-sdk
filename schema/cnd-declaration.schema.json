            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type"
      ],
      "title": "DeclTableNode",
      "type": "object"
    },
    "DeclTermsNode": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "refs": {
          "items": {
            "$ref": "#/$defs/NodeRef"
          },
          "title": "Refs",
          "type": "array"
        },
        "cites": {
          "items": {
            "$ref": "#/$defs/CiteRef"
          },
          "title": "Cites",
          "type": "array"
        },
        "footnotes": {
          "items": {
            "$ref": "#/$defs/FootnoteRef"
          },
          "title": "Footnotes",
          "type": "array"
        },
        "state_metadata": {
          "additionalProperties": true,
          "title": "State Metadata",
          "type": "object"
        },
        "type": {
          "const": "terms",
          "title": "Type",
          "type": "string"
        },
        "tight": {
          "default": true,
          "title": "Tight",
          "type": "boolean"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/TermItem"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "type"
      ],
      "title": "DeclTermsNode",
      "type": "object"
    },
    "DocDate": {
      "description": "Partial or full document date from cnd metadata.",
      "properties": {
        "year": {
          "title": "Year",
          "type": "integer"
        },
        "month": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Month"
        },
        "day": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Day"
        }
      },
      "required": [
        "year"
      ],
      "title": "DocDate",
      "type": "object"
    },
    "DocMetadata": {
      "description": "Bibliographic metadata for the work the CND represents.\n\nThis identifies the *work* \u2014 title, authors, date. The input artifact it\nwas built from is ``Cnd.source``, deliberately separate: the same work\ncan be built from a Typst source and later re-imported from another\nformat (docs/proposals/0008).",
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "date": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocDate"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lang"
        }
      },
      "required": [
        "title"
      ],
      "title": "DocMetadata",
      "type": "object"
    },
    "FootnoteRef": {
      "description": "Forward footnote edge; ``label`` resolves in the CND ``footnotes`` pool.",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "text_span": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Span"
        }
      },
      "required": [
        "label"
      ],
      "title": "FootnoteRef",
      "type": "object"
    },
    "NodeRef": {
      "description": "Forward cross-reference edge to another node.\n\nAn edge is ``{label, text_span?}``: it names its target by label and\nresolves through the CND's label index (docs/adr/0017, superseding the\n``{id, label}`` form of docs/adr/0002). ``text_span`` marks where the\nreference marker sits in the containing node's rendered text, as a\n``[start, end)`` pair of Unicode code-point offsets (docs/adr/0013).",
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "text_span": {
          "anyOf": [
            {
              "items": {
                "type": "integer"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Span"
        }
      },
      "required": [
        "label"
      ],
      "title": "NodeRef",
      "type": "object"
    },
    "RawSource": {
      "description": "The producer's verbatim source for a node, with its language.\n\nA bare string dropped the one thing a consumer needs to decide whether\nto attempt a parse: which language the content is in. ``format`` is an\nopen string (``\"typst\"``, ``\"latex\"``, ``\"mathml\"``\u2026), never a closed\nenum \u2014 a new producer must not require a spec revision.",
      "properties": {
        "format": {
          "title": "Format",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "string"
        }
      },
      "required": [
        "format",
        "value"
      ],
      "title": "RawSource",
      "type": "object"
    },
    "SourceInfo": {
      "description": "The input artifact the CND was built from.\n\n``hash`` is self-describing (``\"sha256:\u2026\"``). Its comparability is\nnarrow and normative: two hashes are comparable only between CNDs from\nthe **same producer over the same source**, where equal means unchanged\nand different means changed. Comparing across producers is meaningless.\n\n``uri`` is an identifier in the producer's own space and is **never\npromised resolvable** \u2014 a consumer must not dereference it.",
      "properties": {
        "type": {
          "title": "Type",
          "type": "string"
        },
        "hash": {
          "title": "Hash",
          "type": "string"
        },
        "uri": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "required": [
        "type",
        "hash"
      ],
      "title": "SourceInfo",
      "type": "object"
    },
    "TableCell": {
      "description": "Single cell inside a table node.",
      "properties": {
        "row": {
          "title": "Row",
          "type": "integer"
        },
        "col": {
          "title": "Col",
          "type": "integer"
        },
        "rowspan": {
          "default": 1,
          "title": "Rowspan",
          "type": "integer"
        },
        "colspan": {
          "default": 1,
          "title": "Colspan",
          "type": "integer"
        },
        "is_header": {
          "default": false,
          "title": "Is Header",
          "type": "boolean"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "row",
        "col",
        "text"
      ],
      "title": "TableCell",
      "type": "object"
    },
    "TermItem": {
      "description": "Single term/description pair of a definition list.",
      "properties": {
        "term": {
          "title": "Term",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        }
      },
      "required": [
        "term",
        "description"
      ],
      "title": "TermItem",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "The source form a producer emits and the builder compiles.\n\nNo ``id``, ``built_at`` or ``cnd_version`` \u2014 all three are the\nbuilder's to supply. ``source`` is kept, optional: a producer\nconverting ``notes.md`` legitimately records what it converted from,\nand provenance is not resolved presentation state.\n\n``declaration_version`` is **required**, matching the CND's required\n``cnd_version``. It exists to stop the first evolution of the schema\nfrom breaking every producer silently (ADR 0019 \u00a73); an omitted\nversion defaulting to \"current\" is exactly the silent assumption it\nguards against, so absence is an error, not \"latest\".",
  "properties": {
    "declaration_version": {
      "title": "Declaration Version",
      "type": "string"
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "doc": {
      "$ref": "#/$defs/DocMetadata"
    },
    "nodes": {
      "items": {
        "discriminator": {
          "mapping": {
            "code": "#/$defs/DeclCodeNode",
            "figure": "#/$defs/DeclFigureNode",
            "heading": "#/$defs/DeclHeadingNode",
            "image": "#/$defs/DeclImageNode",
            "list": "#/$defs/DeclListNode",
            "math": "#/$defs/DeclMathNode",
            "paragraph": "#/$defs/DeclParagraphNode",
            "quote": "#/$defs/DeclQuoteNode",
            "table": "#/$defs/DeclTableNode",
            "terms": "#/$defs/DeclTermsNode"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DeclHeadingNode"
          },
          {
            "$ref": "#/$defs/DeclParagraphNode"
          },
          {
            "$ref": "#/$defs/DeclTableNode"
          },
          {
            "$ref": "#/$defs/DeclQuoteNode"
          },
          {
            "$ref": "#/$defs/DeclCodeNode"
          },
          {
            "$ref": "#/$defs/DeclMathNode"
          },
          {
            "$ref": "#/$defs/DeclFigureNode"
          },
          {
            "$ref": "#/$defs/DeclImageNode"
          },
          {
            "$ref": "#/$defs/DeclListNode"
          },
          {
            "$ref": "#/$defs/DeclTermsNode"
          }
        ]
      },
      "title": "Nodes",
      "type": "array"
    },
    "bibliography": {
      "items": {
        "$ref": "#/$defs/DeclBibEntry"
      },
      "title": "Bibliography",
      "type": "array"
    },
    "footnotes": {
      "items": {
        "$ref": "#/$defs/DeclFootnote"
      },
      "title": "Footnotes",
      "type": "array"
    }
  },
  "required": [
    "declaration_version",
    "doc",
    "nodes"
  ],
  "title": "CND declaration",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnd.dev/schema/cnd-declaration.schema.json"
}

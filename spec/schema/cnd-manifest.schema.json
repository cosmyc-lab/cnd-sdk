    "NodeLocation": {
      "description": "Layout facts the SDK cannot derive from the tree: the page where the\nnode begins in the compiled document.\n\nPositions in reading order (document/sibling/page index and totals) are\nNOT serialized \u2014 the node tree is normatively in reading order, so the\nSDK derives them during traversal (see ``NodeTraverseContext``), the\nsame way reverse reference edges are derived (docs/adr/0008).",
      "properties": {
        "page": {
          "title": "Page",
          "type": "integer"
        }
      },
      "required": [
        "page"
      ],
      "title": "NodeLocation",
      "type": "object"
    },
    "NodeRef": {
      "description": "Forward cross-reference edge to another node.\n\nCanonical shape is ``{id, label}`` (docs/adr/0002); ``text_span`` is an\nadditive optional field marking where the reference marker sits in the\ncontaining node's rendered text, as a ``[start, end)`` pair of Unicode\ncode-point offsets (docs/adr/0013).",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"

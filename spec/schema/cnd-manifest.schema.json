  "description": "Top-level CND manifest produced by the ``typst-cnd`` compiler.",
  "properties": {
    "id": {
      "format": "uuid",
      "title": "Id",
      "type": "string"
    },
    "cnd_version": {
      "title": "Cnd Version",
      "type": "string"
    },
    "doc_hash": {
      "title": "Doc Hash",
      "type": "string"
    },
    "compiled_at": {
      "format": "date-time",
      "title": "Compiled At",
      "type": "string"
    },
    "doc": {
      "$ref": "#/$defs/DocMetadata"
    },
    "nodes": {
      "items": {
        "discriminator": {
          "mapping": {
            "code": "#/$defs/CodeNode",
            "figure": "#/$defs/FigureNode",
            "heading": "#/$defs/HeadingNode",
            "list": "#/$defs/ListNode",
            "math": "#/$defs/MathNode",
            "paragraph": "#/$defs/ParagraphNode",
            "quote": "#/$defs/QuoteNode",
            "table": "#/$defs/TableNode"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/HeadingNode"
          },
          {
            "$ref": "#/$defs/ParagraphNode"
          },
          {
            "$ref": "#/$defs/TableNode"
          },
          {
            "$ref": "#/$defs/QuoteNode"
          },
          {
            "$ref": "#/$defs/CodeNode"
          },
          {
            "$ref": "#/$defs/MathNode"
          },
          {
            "$ref": "#/$defs/FigureNode"
          },
          {
            "$ref": "#/$defs/ListNode"
          }
        ]
      },
      "title": "Nodes",
      "type": "array"
    }
  },
  "required": [
    "cnd_version",
    "doc_hash",
    "compiled_at",
    "doc",
    "nodes"
  ],
  "title": "CND Manifest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cnd.dev/schema/cnd-manifest.schema.json"
}

        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "refs_to": {
          "items": {
            "$ref": "#/$defs/NodeRef"
          },
          "title": "Refs To",
          "type": "array"
        },
        "refs_from": {
          "items": {
            "$ref": "#/$defs/NodeRef"
          },
          "title": "Refs From",
          "type": "array"
        },
        "state_metadata": {
          "additionalProperties": true,
          "title": "State Metadata",
          "type": "object"
        },
        "location": {
          "$ref": "#/$defs/NodeLocation"
        },
        "type": {
          "const": "code",
          "title": "Type",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "lang": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lang"
        },
        "block": {
          "default": true,
          "title": "Block",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "location",
        "type",
        "text"
      ],
      "title": "CodeNode",
      "type": "object"
    },
